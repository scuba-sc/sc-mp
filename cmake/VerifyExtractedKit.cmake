# Verify a hash-pinned extracted archive before any of its contents are used.
# This proves consistency with the selected archive, not origin authentication.
function(sc_mp_verify_extracted_kit kit_root expected_sums label)
  get_filename_component(kit_parent "${kit_root}" DIRECTORY)
  if(IS_SYMLINK "${kit_parent}")
    message(FATAL_ERROR "Reviewed ${label} extraction parent is a symbolic link")
  endif()
  if(IS_SYMLINK "${kit_root}" OR IS_SYMLINK "${kit_root}/SHA256SUMS")
    message(FATAL_ERROR "Reviewed ${label} extraction or inventory is a symbolic link")
  endif()
  file(SHA256 "${kit_root}/SHA256SUMS" _actual_sums)
  if(NOT _actual_sums STREQUAL expected_sums)
    message(FATAL_ERROR "Reviewed ${SC_MP_NET_BOUNDARY_PROFILE} ${label} inventory changed")
  endif()
  file(STRINGS "${kit_root}/SHA256SUMS" _inventory)
  set(_expected_files SHA256SUMS)
  foreach(_entry IN LISTS _inventory)
    if(NOT _entry MATCHES "^([0-9a-f]+)  ([^;]+)$")
      message(FATAL_ERROR "Malformed reviewed ${label} inventory")
    endif()
    set(_expected_hash "${CMAKE_MATCH_1}")
    set(_path "${CMAKE_MATCH_2}")
    string(LENGTH "${_expected_hash}" _hash_length)
    if(NOT _hash_length EQUAL 64 OR _path MATCHES "(^/|(^|/)\\.\\.(/|$)|[\\\\])")
      message(FATAL_ERROR "Unsafe reviewed ${label} inventory path")
    endif()
    list(APPEND _expected_files "${_path}")
  endforeach()
  cmake_policy(PUSH)
  cmake_policy(SET CMP0009 NEW)
  file(GLOB_RECURSE _kit_entries LIST_DIRECTORIES true RELATIVE "${kit_root}" "${kit_root}/*")
  cmake_policy(POP)
  set(_actual_files "")
  foreach(_path IN LISTS _kit_entries)
    if(IS_SYMLINK "${kit_root}/${_path}")
      message(FATAL_ERROR "Reviewed ${label} extraction contains a symbolic link: ${_path}")
    endif()
    if(NOT IS_DIRECTORY "${kit_root}/${_path}")
      list(APPEND _actual_files "${_path}")
    endif()
  endforeach()
  list(SORT _expected_files)
  list(SORT _actual_files)
  if(NOT _expected_files STREQUAL _actual_files)
    message(FATAL_ERROR "Reviewed ${label} extraction has missing or extra files")
  endif()
  foreach(_entry IN LISTS _inventory)
    string(REGEX MATCH "^([0-9a-f]+)  (.+)$" _matched "${_entry}")
    set(_expected_hash "${CMAKE_MATCH_1}")
    set(_path "${CMAKE_MATCH_2}")
    file(SHA256 "${kit_root}/${_path}" _actual_hash)
    if(NOT _actual_hash STREQUAL _expected_hash)
      message(FATAL_ERROR "Reviewed ${label} extraction file changed: ${_path}")
    endif()
  endforeach()

endfunction()
