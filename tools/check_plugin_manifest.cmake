if(SC_MP_TEST_SOURCE)
  if(NOT DEFINED SC_MP_SOURCE_PLUGIN_DIR OR NOT DEFINED SC_MP_EXPECTED_SOURCE_MODULE)
    message(FATAL_ERROR "Source manifest check needs SC_MP_SOURCE_PLUGIN_DIR and SC_MP_EXPECTED_SOURCE_MODULE")
  endif()
  set(_plugin_dir "${SC_MP_SOURCE_PLUGIN_DIR}")
  set(_expected_module "${SC_MP_EXPECTED_SOURCE_MODULE}")
  set(_verify_module FALSE)
elseif(SC_MP_TEST_INSTALL)
  if(NOT DEFINED SC_MP_EXPECTED_MODULE OR SC_MP_EXPECTED_MODULE STREQUAL "")
    message(FATAL_ERROR "SC_MP_EXPECTED_MODULE must name the built module artifact")
  endif()
  if(NOT DEFINED SC_MP_BUILD_DIR OR SC_MP_BUILD_DIR STREQUAL "")
    message(FATAL_ERROR "Installed manifest check needs SC_MP_BUILD_DIR")
  endif()
  if(DEFINED SC_MP_INSTALL_PREFIX)
    message(FATAL_ERROR "SC_MP_INSTALL_PREFIX is unsupported; installed manifest checks allocate their own scratch directory")
  endif()
  if(NOT DEFINED SC_MP_PYTHON OR SC_MP_PYTHON STREQUAL "" OR NOT EXISTS "${SC_MP_PYTHON}")
    message(FATAL_ERROR "Installed manifest check requires Python 3 to allocate a fresh scratch directory")
  endif()

  # Atomic creation avoids deleting or reusing a caller's existing install tree.
  # Retain the scratch directory: path-based recursive cleanup can race replacement.
  execute_process(
    COMMAND "${SC_MP_PYTHON}" -X utf8 -c "import pathlib, tempfile; print(pathlib.Path(tempfile.mkdtemp(prefix='sc-mp-manifest-')).as_posix())"
    RESULT_VARIABLE _scratch_result OUTPUT_VARIABLE _scratch ERROR_VARIABLE _scratch_error
    OUTPUT_STRIP_TRAILING_WHITESPACE ENCODING UTF-8)
  if(NOT "${_scratch_result}" STREQUAL "0" OR _scratch STREQUAL "")
    message(FATAL_ERROR "Could not allocate installed manifest scratch (${_scratch_result}): ${_scratch_error}")
  endif()
  message(STATUS "SC_MP_MANIFEST_SCRATCH=${_scratch}")
  if(DEFINED SC_MP_CONFIG AND NOT SC_MP_CONFIG STREQUAL "")
    execute_process(
      COMMAND "${CMAKE_COMMAND}" --install "${SC_MP_BUILD_DIR}" --prefix "${_scratch}" --component multiplayer --config "${SC_MP_CONFIG}"
      RESULT_VARIABLE _install_result OUTPUT_VARIABLE _install_stdout ERROR_VARIABLE _install_stderr)
  else()
    execute_process(
      COMMAND "${CMAKE_COMMAND}" --install "${SC_MP_BUILD_DIR}" --prefix "${_scratch}" --component multiplayer
      RESULT_VARIABLE _install_result OUTPUT_VARIABLE _install_stdout ERROR_VARIABLE _install_stderr)
  endif()
  if(NOT "${_install_result}" STREQUAL "0")
    message(FATAL_ERROR "Installing multiplayer for manifest check failed (${_install_result}):\n${_install_stdout}\n${_install_stderr}")
  endif()
  set(_plugin_dir "${_scratch}/data/plugins/multiplayer")
  set(_expected_module "${SC_MP_EXPECTED_MODULE}")
  set(_verify_module TRUE)
else()
  if(NOT DEFINED SC_MP_EXPECTED_MODULE OR SC_MP_EXPECTED_MODULE STREQUAL "")
    message(FATAL_ERROR "SC_MP_EXPECTED_MODULE must name the built module artifact")
  endif()
  if(NOT DEFINED SC_MP_PLUGIN_DIR)
    message(FATAL_ERROR "Staged manifest check needs SC_MP_PLUGIN_DIR")
  endif()
  set(_plugin_dir "${SC_MP_PLUGIN_DIR}")
  set(_expected_module "${SC_MP_EXPECTED_MODULE}")
  set(_verify_module TRUE)
endif()

set(_manifest "${_plugin_dir}/plugin.ini")
if(NOT EXISTS "${_manifest}")
  message(FATAL_ERROR "Multiplayer manifest is missing: ${_manifest}")
endif()
file(STRINGS "${_manifest}" _entries REGEX "^[ \t]*entry[ \t]*=")
list(LENGTH _entries _entry_count)
if(NOT _entry_count EQUAL 1)
  message(FATAL_ERROR "${_manifest} must contain exactly one entry field, found ${_entry_count}")
endif()
list(GET _entries 0 _entry_line)
string(REGEX REPLACE "^[ \t]*entry[ \t]*=[ \t]*" "" _entry "${_entry_line}")
string(STRIP "${_entry}" _entry)
if(NOT "${_entry}" STREQUAL "${_expected_module}")
  message(FATAL_ERROR "${_manifest} entry '${_entry}' does not match expected module '${_expected_module}'")
endif()
if(_verify_module)
  if(NOT EXISTS "${_plugin_dir}/${_expected_module}" OR IS_DIRECTORY "${_plugin_dir}/${_expected_module}")
    message(FATAL_ERROR "Manifest target is missing or not a regular file: ${_plugin_dir}/${_expected_module}")
  endif()
endif()
if(_verify_module)
  message(STATUS "${_manifest} points to built module ${_expected_module}")
else()
  message(STATUS "${_manifest} remains a concrete source manifest for ${_expected_module}")
endif()
